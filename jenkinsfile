pipeline {
    agent any

    stages {
stage('Verify POM') {
    steps {
        bat 'type pom.xml'
    }
}
        stage('Build') {
            steps {
                bat 'mvn clean test'
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
